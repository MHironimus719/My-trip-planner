{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cizxmudgvueofjzfttxo.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "my-trip-planner",
      "version": "0.1.0",
      "title": "My Trip Planner"
    },
    "tools": [
      {
        "name": "list_trips",
        "title": "List trips",
        "description": "List the signed-in user's trips, most recent first. Each trip includes dates, destination, client/event, booking needs, and flight/hotel/car details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum number of trips to return (default 20, max 50)."
            },
            "include_cancelled": {
              "type": "boolean",
              "description": "Include cancelled trips (default false)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_trip",
        "title": "Get trip details",
        "description": "Get one trip in full detail: dates, destination, flights (outbound and return), hotel, car rental, and the day-by-day itinerary items.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "trip_id": {
              "type": "string",
              "format": "uuid",
              "description": "The trip's ID (from list_trips)."
            }
          },
          "required": [
            "trip_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_expenses",
        "title": "List expenses",
        "description": "List the signed-in user's expenses, newest first. Filter by trip or reimbursement status — useful for seeing what is still pending reimbursement.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "trip_id": {
              "type": "string",
              "format": "uuid",
              "description": "Only show expenses for this trip (from list_trips)."
            },
            "reimbursed_status": {
              "type": "string",
              "enum": [
                "Not submitted",
                "Submitted",
                "Partially reimbursed",
                "Fully reimbursed"
              ],
              "description": "Only show expenses with this reimbursement status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum number of expenses to return (default 25, max 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
